# Copy to .env for `netlify dev`, and set the same values in
# Netlify > Site configuration > Environment variables for deploys.
# Never commit real values.

# Headless channel > Customer Account API > Client ID / Client secret (Confidential client)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Domain used for OpenID discovery: https://<this>/.well-known/openid-configuration
# Your custom storefront domain (or your-store.myshopify.com).
SHOPIFY_SHOP_DOMAIN=yourstore.com

# Public origin of the storefront the dashboard lives on.
STOREFRONT_URL=https://yourstore.com

# Public origin of this auth service (custom subdomain on the same site as the storefront).
# The OAuth callback is ${PUBLIC_BASE_URL}/auth/callback and must be registered in Shopify.
PUBLIC_BASE_URL=https://auth.yourstore.com

# 32+ random bytes, base64url. Generate with: npm run secret
SESSION_SECRET=
# Optional: previous secret, accepted for decryption only while rotating keys.
SESSION_SECRET_PREVIOUS=

# Optional overrides
# DASHBOARD_PATH=/pages/dashboard
# Extra origins allowed to call the API (comma separated), e.g. https://www.yourstore.com
# ALLOWED_ORIGINS=
# Where Shopify sends the customer after logout. Must be registered as a Logout URI.
# Defaults to ${STOREFRONT_URL}/account/logout so the storefront session ends too.
# POST_LOGOUT_REDIRECT_URI=
# Absolute session lifetime in days (default 14).
# SESSION_MAX_AGE_DAYS=14
