{%- comment -%}
  Full-width hero image with text. "Add animation" opens the image out from a centred
  370 × 419 window, then fades the text up.
  Styles and animation: styles/sections/_custom-hero-banner.scss. Playback: assets/main.js.
{%- endcomment -%}
{%- liquid
  assign image = section.settings.image
  assign animate = section.settings.enable_animation
  assign fetch_priority = 'auto'
  assign loading = 'lazy'
  if section.index == 1
    assign fetch_priority = 'high'
    assign loading = 'eager'
  endif
-%}

{% style %}
  #CustomHeroBanner-{{ section.id }} {
    --custom-hero-banner-background: {{ section.settings.background_color }};
    --custom-hero-banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    color: {{ section.settings.text_color }};
  }
  /* Desktop */
  #CustomHeroBanner-{{ section.id }} .custom-hero-banner__heading {
    font-size: {{ section.settings.heading_desktop_size }}px;
    font-weight: {{ section.settings.heading_desktop_font_weight }};
    line-height: {{ section.settings.heading_desktop_line_height }}%;
  }
  /* Tablet */
  @media screen and (max-width: 989px) {
    #CustomHeroBanner-{{ section.id }} .custom-hero-banner__heading {
      font-size: {{ section.settings.heading_tablet_size }}px;
      font-weight: {{ section.settings.heading_tablet_font_weight }};
      line-height: {{ section.settings.heading_tablet_line_height }}%;
    }
  }
  /* Mobile */
  @media screen and (max-width: 749px) {
    #CustomHeroBanner-{{ section.id }} .custom-hero-banner__heading {
      font-size: {{ section.settings.heading_mobile_size }}px;
      font-weight: {{ section.settings.heading_mobile_font_weight }};
      line-height: {{ section.settings.heading_mobile_line_height }}%;
    }
  }
{% endstyle %}

{%- if animate -%}
  <noscript>
    <style>
      #CustomHeroBanner-{{ section.id }} *,
      #CustomHeroBanner-{{ section.id }} *::after {
        animation: none !important;
      }
    </style>
  </noscript>
{%- endif -%}

<custom-hero-banner
  id="CustomHeroBanner-{{ section.id }}"
  class="custom-hero-banner custom-hero-banner--{{ section.settings.height }} custom-hero-banner--content-{{ section.settings.content_position }} custom-hero-banner--align-{{ section.settings.content_alignment }}{% if animate %} custom-hero-banner--animate{% endif %}"
>
  <div class="custom-hero-banner__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 3840
        | image_tag:
          class: 'custom-hero-banner__image',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          loading: loading,
          fetchpriority: fetch_priority
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'custom-hero-banner__image placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if section.settings.heading != blank
    or section.settings.text != blank
    or section.settings.button_label != blank
  -%}
    <div class="custom-hero-banner__content page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-hero-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="custom-hero-banner__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          class="custom-hero-banner__button button button--primary"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</custom-hero-banner>

{% schema %}
{
  "name": "Custom hero banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Add animation",
      "info": "The image starts as a 370 × 419px window in the centre, pulls the middle of its sides inward, then opens out to the full banner. The text fades up afterwards. Plays once the banner is in view.",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background before the image opens",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.enable_animation }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PREMIUM AUSTRALIAN DRINK HOUSE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "visible_if": "{{ section.settings.button_label != blank }}"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Desktop: 'Heading' Settings",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_desktop_size",
      "label": "Size",
      "min": 12,
      "max": 104,
      "step": 1,
      "default": 40,
      "unit": "px",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_desktop_font_weight",
      "label": "Font Weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 700,
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_desktop_line_height",
      "label": "Line Height",
      "min": 5,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "Tablet: 'Heading' Settings",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_tablet_size",
      "label": "Size",
      "min": 12,
      "max": 104,
      "step": 1,
      "default": 34,
      "unit": "px",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_tablet_font_weight",
      "label": "Font Weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 700,
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_tablet_line_height",
      "label": "Line Height",
      "min": 5,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "Mobile: 'Heading' Settings",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "Size",
      "min": 12,
      "max": 104,
      "step": 1,
      "default": 28,
      "unit": "px",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_font_weight",
      "label": "Font Weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 700,
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_line_height",
      "label": "Line Height",
      "min": 5,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "%",
      "visible_if": "{{ section.settings.heading != blank }}"
    }
  ],
  "presets": [
    {
      "name": "Custom hero banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
